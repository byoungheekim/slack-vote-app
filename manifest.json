{
  "display_information": {
    "name": "Vote App",
    "description": "Slack 투표 앱",
    "background_color": "#2c2d30"
  },
  "features": {
    "bot_user": {
      "display_name": "vote-app",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/vote",
        "description": "투표를 생성합니다",
        "usage_hint": "질문 | 옵션1 | 옵션2",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": ["commands", "chat:write"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
